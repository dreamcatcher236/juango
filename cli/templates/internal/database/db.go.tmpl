func (d *Database) GetDistinctResourceTypes(ctx context.Context) ([]string, error) {
	var types []string
	err := d.DB().SelectContext(ctx, &types,
		"SELECT DISTINCT resource_type FROM audit_log ORDER BY resource_type")
	if err != nil {
		return nil, err
	}
	return types, nil
}
