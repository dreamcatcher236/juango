package cli

import (
	"net/http"
	"os"
	"os/signal"
	"syscall"

	"github.com/rs/zerolog"
	"github.com/rs/zerolog/log"
	"github.com/spf13/cobra"
	"{{.ModulePath}}"
	"{{.ModulePath}}/internal/types"
)

var serveFlags struct {
	configPath string
}

var serveCmd = &cobra.Command{
	Use:   "serve",
	Short: "Start the server",
	RunE:  runServe,
}

func init() {
	serveCmd.Flags().StringVarP(&serveFlags.configPath, "config", "c", "", "Path to config file")
}

func runServe(cmd *cobra.Command, args []string) error {
	// Setup logging
	log.Logger = log.Output(zerolog.ConsoleWriter{Out: os.Stdout})

	// Load config
	if err := types.ReadViperConfig(serveFlags.configPath, serveFlags.configPath != ""); err != nil {
		return err
	}

	config, err := types.GetConfig()
	if err != nil {
		return err
	}

	// Create app
	app, err := {{.ProjectNameLower}}.New(config)
	if err != nil {
		return err
	}

	// Handle shutdown signals
	sigChan := make(chan os.Signal, 1)
	signal.Notify(sigChan, syscall.SIGINT, syscall.SIGTERM)

	// Start server in background
	errChan := make(chan error, 1)
	go func() {
		if err := app.Serve(); err != nil && err != http.ErrServerClosed {
			errChan <- err
		}
	}()

	// Wait for signal or error
	select {
	case sig := <-sigChan:
		log.Info().Str("signal", sig.String()).Msg("Received signal, shutting down gracefully")
	case err := <-errChan:
		log.Error().Err(err).Msg("Server error")
	}

	// Graceful shutdown (closes HTTP server + checkpoints WAL)
	if err := app.Close(); err != nil {
		log.Error().Err(err).Msg("Error during shutdown")
	}

	log.Info().Msg("Shutdown complete")
	return nil
}
