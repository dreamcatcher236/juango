package cli

import (
	"context"
	"fmt"
	"os"
	"text/tabwriter"

	"github.com/rs/zerolog"
	"github.com/rs/zerolog/log"
	"github.com/spf13/cobra"
	"{{.ModulePath}}/internal/database"
	"{{.ModulePath}}/internal/types"
)

var listAdminsFlags struct {
	configPath string
}

var listAdminsCmd = &cobra.Command{
	Use:   "list-admins",
	Short: "List all admin users",
	RunE:  runListAdmins,
}

func init() {
	listAdminsCmd.Flags().StringVarP(&listAdminsFlags.configPath, "config", "c", "", "Path to config file")
}

func runListAdmins(cmd *cobra.Command, args []string) error {
	log.Logger = log.Output(zerolog.ConsoleWriter{Out: os.Stdout})

	if err := types.ReadViperConfig(listAdminsFlags.configPath, listAdminsFlags.configPath != ""); err != nil {
		return err
	}
	config, err := types.GetConfig()
	if err != nil {
		return err
	}

	db, err := database.New(config.Database.Path)
	if err != nil {
		return fmt.Errorf("opening database: %w", err)
	}
	defer db.Close()

	ctx := context.Background()
	admins, err := db.GetAdminUsers(ctx)
	if err != nil {
		return fmt.Errorf("listing admins: %w", err)
	}

	if len(admins) == 0 {
		fmt.Println("No admin users found")
		return nil
	}

	w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
	fmt.Fprintln(w, "EMAIL\tNAME\tLAST LOGIN")
	for _, admin := range admins {
		lastLogin := "Never"
		if admin.LastLogin != nil {
			lastLogin = admin.LastLogin.Format("2006-01-02 15:04:05")
		}
		fmt.Fprintf(w, "%s\t%s\t%s\n", admin.Email, admin.DisplayName, lastLogin)
	}
	w.Flush()

	return nil
}
